// transform form to url query
function formToUrlString(form) {
    const formRaw = new FormData(form)
    const dataList = [...formRaw.entries()]
    const cleaned = dataList.filter(attr => !!attr[1])
    const encoded = cleaned.map(attr => encodeURIComponent(attr[0]) + '=' + encodeURIComponent(attr[1]))
    const stringed = encoded.join('&')
    return stringed
}

// get data for specific url
async function getData(url) {
  try {
    const response = await fetch(url)
    if (!response.ok) {
      throw new Error(`Response status: ${response.status}`)
    }
    const body = await response.text()
    return body
  } catch(error) {
    console.error(error.message)
    return null
  }

}
// send data to the server
async function putData(url, data) {
  try {
    const response = await fetch(url, {
      method: 'POST',
      body: JSON.stringify(data),
      headers: {
        "Content-Type": "application/json"
      }
    })
    if (!response.ok) {
      throw new Error(`Response status: ${response.status}`)
    }
    const object = await response.json()
    return object
  } catch(error) {
    console.error(error.message)
    return null
  }

}

// parse url origin to new pathname
function parseUrl(pathname) {
  if (window.location) {
    const currentUrl = new URL(window.location)
    const origin = currentUrl.origin
    const nextUrl = new URL(pathname, origin)
    return nextUrl.href
  } else {
    return null
  }
}

// update url with current active queries
function updateUrl(url, queries_to_set, queries_to_del=null) {
    const newUrlQuery = new URL(url)
    const queryParams = newUrlQuery.searchParams
    if (queries_to_del) {
        queries_to_del.forEach((query) => {
            queryParams.delete(query)
        })
    }
    if (queries_to_set) {
        Object.keys(queries_to_set).forEach((key) => {
            queryParams.set(key, queries_to_set[key])
        })
    }
    newUrlQuery.search = queryParams.toString()
    return newUrlQuery.toString()
} 


// alert user about changes
async function actionDialog(messages) {
  alertMessage.innerHTML = messages
  alertDialog.showModal()
  let accept = false
  let waitForPressResolve;
  const waitForPress = () => {
      return new Promise(resolve => waitForPressResolve = resolve);
  }
  alertApproveBtn.addEventListener('click', () => {
      if (waitForPress) {
          accept = true
          alertDialog.close()
          waitForPressResolve()

      }
  })
  alertDisapproveBtn.addEventListener('click', () => {
      if (waitForPress) {
          alertDialog.close()
          waitForPressResolve()
      }
  })
  await waitForPress()
  if (accept) return true
  return false
  
}

function displayMessage(messageList) {
  const messageWrapper = document.getElementById('message-wrapper')
  const messageContainer = messageWrapper.querySelector('div[data-message-blueprint]')
  const containerClone = messageContainer.cloneNode(true)
  const innerElement = containerClone.querySelector('#message-inner')
  const closeButton = containerClone.querySelector('button')
  messageList.forEach((line) => {
    let formatLine = line.replace(/ /g, '&nbsp;')
    innerElement.innerHTML += '<p>' + formatLine + '</p>'
  })
  closeButton.addEventListener('click', () => containerClone.remove())
  delete containerClone.dataset.messageBlueprint
  messageWrapper.appendChild(containerClone)
}

function displayError(errors) {
  const errorWrapper = document.getElementById('error-wrapper')
  const errorContainer = errorWrapper.querySelector('div[data-error-blueprint]')
  const containerClone = errorContainer.cloneNode(true)
  const innerElement = containerClone.querySelector('#error-inner')
  const closeButton = containerClone.querySelector('button')
  if (Array.isArray(errors)) {
    errors.forEach((line) => {
      let formatLine = line.replace(/ /g, '&nbsp;')
      innerElement.innerHTML += '<p>' + formatLine + '</p>'
    })
  } else if (typeof errors === 'object' && errors !== null) {
    Object.entries(errors).forEach(([name, errorList]) => {
      innerElement.innerHTML += '<p>' + name + '</p>'
      errorList.forEach((line) => {
        let formatLine = line.replace(/ /g, '&nbsp;')
        innerElement.innerHTML += '<p>' + '&nbsp;' + '*' + '&nbsp;' + formatLine + '</p>'
      })
    })
  }
 
  closeButton.addEventListener('click', () => containerClone.remove())
  delete containerClone.dataset.errorBlueprint
  errorWrapper.appendChild(containerClone)
}

function updateUrlHistory(url) {
    const nextState = { additionalInformation: 'Updated the URL with JS' };
    window.history.pushState(nextState, '', url);
}

function reloadOnGoBack() {
  window.addEventListener('pageshow', function (event) {
    if (event.persisted) {
        window.location.reload()
    }
})
