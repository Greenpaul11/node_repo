<script type="text/javascript">
  
  let currentPath
  let sectionPath 
  let currentButtonDirect
  let currentLeftSection
  let sectionsLeftColumn
  let sectionDropdownButtons
  let adminLeftWrapper 
  let adminLeftDropdown
  let currentActiveDropdown
  let shrinkLeftColumnButton
  let growLeftColumnButton
  let shrinkLeftColumnActive
  
  function interactAdminPanel() {
    currentPath = window.location.pathname
    sectionPath = Array.from(currentPath.split('/')).slice(0, 3).join('/')
    sectionsLeftColumn = document.querySelectorAll('div[data-section]')
    for (const section of sectionsLeftColumn) {
      let directionButtons = section.querySelectorAll('button[data-direction]')
      for (const button of directionButtons) {
        if (button.dataset.direction === sectionPath) {
          currentButtonDirect = button
          currentButtonDirect.dataset.active = 'true'
          currentLeftSection = section
          currentLeftSection.dataset.active = 'true'
          toggleActiveDropdown(currentLeftSection)
          break
        }
      }
      if (currentLeftSection) {
        let currentSectionButton = section.querySelector('button')
        currentSectionButton.dataset.currentDirection = 'true'
        break
      }
    }
    sectionDropdownButtons = document.querySelectorAll('button[data-dropdown-button]')
    sectionDropdownButtons.forEach((button) => {
      button.addEventListener('click', () => {
        toggleSections(button)
      })
    })

    adminLeftWrapper = document.getElementById('admin-left-wrapper')
    adminLeftDropdown = adminLeftWrapper.querySelector('#admin-left-dropdown')
    if (!menuButton) {
      menuButton = document.getElementById('menu-button')
    }
    menuButton.addEventListener('click', (event) => {
      const active = adminLeftDropdown.dataset.active
      if (!active) {
        adminLeftWrapper.dataset.active = 'true'
        adminLeftDropdown.dataset.active = 'true'
      } else {
        delete adminLeftWrapper.dataset.active
        delete adminLeftDropdown.dataset.active
      }
    })
    const mediaQueryAdmin = window.matchMedia('(max-width: 900px)')
    mediaQueryAdmin.addEventListener('change', handleMobileChangeAdminPanel)
    if (window.innerWidth <= 900) adminLeftToMobile()

    shrinkLeftColumnButton = document.getElementById('admin-shrink-left')
    growLeftColumnButton = document.getElementById('admin-grow-left')
    shrinkLeftColumnButton.addEventListener('click', () => {
      if (currentLeftSection) {
        delete currentLeftSection.dataset.active
        currentLeftSection = null
      }
      toggleActiveDropdown()
      adminLeftWrapper.dataset.shrink = 'true'
    })
    growLeftColumnButton.addEventListener('click', () => {
      delete adminLeftWrapper.dataset.shrink
    })
  }

  function toggleSections(button) {
    const parent = button.parentElement
    if (!currentLeftSection) {
      parent.dataset.active = 'true'
      currentLeftSection = parent
      toggleActiveDropdown(currentLeftSection)
    } else if (currentLeftSection === parent) {
      delete currentLeftSection.dataset.active
      currentLeftSection = null
      toggleActiveDropdown()
    } else {
      delete currentLeftSection.dataset.active
      setTimeout(() => {
        parent.dataset.active = 'true'
        currentLeftSection = parent
        currentActiveDropdown(parent)
      }, 300)
    }
  }

  function toggleActiveDropdown(parent=null) {
    if (currentActiveDropdown) {
      delete currentActiveDropdown.dataset.active
    }
    if (parent) {
      currentActiveDropdown = parent.querySelector('.dropdown')
      currentActiveDropdown.dataset.active = 'true'
    }
  }

  function handleMobileChangeAdminPanel(event) {
    if (event.matches) {
      adminLeftToMobile()
    } else {
      adminLeftToDesktop()
    }
  }
  
  function adminLeftToMobile() {
    adminLeftWrapper.classList.add('dropdown-container')
    adminLeftDropdown.classList.add('dropdown')
    if (adminLeftWrapper.dataset.shrink) {
      delete adminLeftWrapper.dataset.shrink
      shrinkLeftColumnActive = true
    }
  }
  
  function adminLeftToDesktop() {
    adminLeftWrapper.classList.remove('dropdown-container')
    adminLeftDropdown.classList.remove('dropdown')
    if (shrinkLeftColumnActive) {
      adminLeftWrapper.dataset.shrink = 'true'
    }
  }
  
  
  interactAdminPanel()
























