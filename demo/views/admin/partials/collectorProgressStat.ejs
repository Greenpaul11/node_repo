<% if (stat) { %> 
<div class="collector-progress-wrapper" data-id-progress="<%= stat['name'] %>">
  <div data-attribute="collect urls">
      <p>Urls collecting job:</p>
      <div class="collector-progress-container">
        <div class="collector-progress-bar" data-subattribute="percentage" style="width: <%= stat['collect urls']['percentage'] %>%"></div>
        <div class="collector-progress-bar progress-success" data-subattribute="percentage success" style="width: <%= stat['collect urls']['percentage success'] %>%"></div>
      </div>
      <span data-subattribute="message"></span>
      <span>total: <b data-subattribute="total string"><%= stat['collect urls']['total string'] %></b></span>
      <span>errors: <b data-subattribute="errors"><%= stat['collect urls']['errors'] %></b></span>
  </div>
  <div data-attribute="collect price">
      <p>Price collecting job:</p>
      <div class="collector-progress-container">
        <div class="collector-progress-bar" data-subattribute="percentage" style="width: <%= stat['collect price']['percentage'] %>%"></div>
        <div class="collector-progress-bar progress-success" data-subattribute="percentage success" style="width: <%= stat['collect price']['percentage success'] %>%"></div>
      </div>
      <span data-subattribute="message"></span>
      <span>success: <b data-subattribute="success"><%= stat['collect price']['success'] %></b></span>
      <span>failed: <b data-subattribute="failed"><%= stat['collect price']['failed'] %></b></span>
      <span>total: <b data-subattribute="total string"><%= stat['collect price']['total string'] %></b></span>
      <span>errors: <b data-subattribute="errors"><%= stat['collect price']['errors'] %></b></span>
  </div>
  <div data-attribute="format price">
      <p>Price formating job:</p>
      <div class="collector-progress-container">
        <div class="collector-progress-bar" data-subattribute="percentage" style="width: <%= stat['format price']['percentage'] %>%"></div>
        <div class="collector-progress-bar progress-success" data-subattribute="percentage success" style="width: <%= stat['format price']['percentage success'] %>%"></div>
      </div>
      <span data-subattribute="message"></span>
      <span>success: <b data-subattribute="success"><%= stat['format price']['success'] %></b></span>
      <span>merged: <b data-subattribute="merged"><%= stat['format price']['merged'] %></b></span>
      <span>failed: <b data-subattribute="failed"><%= stat['format price']['failed'] %></b></span>
      <span>total: <b data-subattribute="total string"><%= stat['format price']['total string'] %></b></span>
      <span>errors: <b data-subattribute="errors"><%= stat['format price']['errors'] %></b></span>
  </div>
  <div data-attribute="inject price">
