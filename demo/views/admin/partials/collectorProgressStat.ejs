      <span>total: <b data-subattribute="total string">0</b></span>
  </div>
  <div data-attribute="collect product">
      <p>Laptops collecting job:</p>
      <div class="collector-progress-container">
          <div class="collector-progress-bar" data-subattribute="percentage" style="width: 0"></div>
      </div>
      <span data-subattribute="message"></span>
      <span>success: <b data-subattribute="success">0</b></span>
      <span>failed: <b data-subattribute="failed">0</b></span>
      <span>total: <b data-subattribute="total string">0</b></span>
  </div>
  <div data-attribute="format product">
      <p>Laptops formating job:</p>
      <div class="collector-progress-container">
          <div class="collector-progress-bar" data-subattribute="percentage" style="width: 0"></div>
      </div>
      <span data-subattribute="message"></span>
      <span>success: <b data-subattribute="success">0</b></span>
      <span>pending: <b data-subattribute="pending">0</b></span>
      <span>failed: <b data-subattribute="failed">0</b></span>
      <span>total: <b data-subattribute="total string">0</b></span>
  </div>
  <div data-attribute="inject product">
      <p>Laptop injecting job:</p>
      <div class="collector-progress-container">
          <div class="collector-progress-bar" data-subattribute="percentage" style="width: 0"></div>
      </div>
      <span data-subattribute="message"></span>
      <span>success: <b data-subattribute="success">0</b></span>
