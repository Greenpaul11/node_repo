        <option value="288" <% if (settings['interval laptop removal'] === 288) { %> selected <% } %>>14 days</option>
        <option value="720" <% if (settings['interval laptop removal'] === 720) { %> selected <% } %>>30 days</option>
    </select></label>
    <% if (settings['file removal on']) { %> 
