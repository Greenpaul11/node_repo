        <option value="48" <% if (settings['interval file removal'] === 40) { %> selected <% } %>>48 hours</option>
        <option value="72" <% if (settings['interval file removal'] === 72) { %> selected <% } %>>3 days</option>
        <option value="96" <% if (settings['interval file removal'] === 96) { %> selected <% } %>>4 days</option>
        <option value="120" <% if (settings['interval file removal'] === 120) { %> selected <% } %>>5 days</option>
        <option value="144" <% if (settings['interval file removal'] === 144) { %> selected <% } %>>6 days</option>
        <option value="168" <% if (settings['interval file removal'] === 168) { %> selected <% } %>>7 days</option>
        <option value="288" <% if (settings['interval file removal'] === 288) { %> selected <% } %>>14 days</option>
        <option value="720" <% if (settings['interval file removal'] === 720) { %> selected <% } %>>30 days</option>
    </select></label>
    <label>Expired after<select name="expired file removal">
        <option value="720" <% if (settings['expired file removal'] === 720) { %> selected <% } %>>30 days</option>
        <option value="1440" <% if (settings['expired file removal'] === 1440) { %> selected <% } %>>60 days</option>
        <option value="2160" <% if (settings['expired file removal'] === 2160) { %> selected <% } %>>90 days</option>
        <option value="2880" <% if (settings['expired file removal'] === 2880) { %> selected <% } %>>120 days</option>
    </select></label>
    <button type="submit">Save</button>
</form>