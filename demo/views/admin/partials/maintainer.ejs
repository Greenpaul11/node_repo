<script type="text/javascript">
    let jobButton
    let dateSelects
    function interact() {
        dateSelects = document.querySelectorAll('select[data-job]')
        dateSelects.forEach((select) => {
            select.addEventListener('change', async (event) => {
                const job = event.currentTarget.dataset.job
                const jobIndex = event.currentTarget.value
                const url = updateUrl(window.location, {update_results: true, [job]: jobIndex})
                const htmlBody = await getData(url)
                if (htmlBody) {
                    const resultsHtml = document.querySelector('#result_items')
                    resultsHtml.innerHTML = htmlBody
                    interact()
                }
                const urlAfter = updateUrl(url, null, ['update_results'])
                updateUrlHistory(urlAfter)
            })
        })
        const jobButtons = document.querySelectorAll('button[data-job]')
        jobButtons.forEach((button) => {
            if (button.dataset.jobRunning) {
                jobButton = button
                setEventSource(onStart, onEnd)
                button.addEventListener('click', closeEventSource)
            } else {
                button.addEventListener('click', openEventSource)
            }
        })
    }
    const onStart = () => {
        jobButton.innerText = 'Cancel'
        jobButton.dataset.job.running = 'true'
        if (jobButton.dataset.runner) {
            document.querySelector(`[data-runner-el=${jobButton.dataset.runner}]`).style.display = 'block'
        }
    }
    const onEnd = async () => {
        // update whole content element
        const job = jobButton.dataset.job
        const url = updateUrl(window.location, {update_results: true, [job]: 0})
        const htmlBody = await getData(url)
        if (htmlBody) {
            const resultsHtml = document.querySelector('#result_items')
            resultsHtml.innerHTML = htmlBody
            interact()
        }
        const urlAfter = updateUrl(url, null, ['update_results'])
        updateUrlHistory(urlAfter)
        jobButton = null
    }
    async function openEventSource(event) {
        jobButton = event.target
        const runTempTarget = 'maintainer'
        const job = jobButton.dataset.job 
        const runStart = Object.fromEntries([[job, [runTempTarget]]])
        const submitUrl = parseUrl('/admin/request_collect_job')
        const result = await fetch(submitUrl, {
            method: 'POST',
            body: JSON.stringify({runStart: runStart}),
            headers: {
                "Content-Type": "application/json"
            }
        })
        const [accepted, error] = await result.json()
        if (accepted) {
            const buttonText = jobButton.innerText
            setEventSource(onStart, onEnd)
            jobButton.removeEventListener('click', openEventSource)
            jobButton.addEventListener('click', closeEventSource)
        } else {
            let errors = ''
            for (const [errorKey, errorValues] of Object.entries(error) ) {
                for (const error of errorValues) {
                    errors += `<p>${errorKey} ${errorValues}</p>`
                }
            }
            displayErros(errors) 
        }
    }

    async function closeEventSource(event) {
        const button = event.target
        const job = button.dataset.job
        const runStop = Object.fromEntries([[job, true]])
        const submitUrl = parseUrl('/admin/request_collect_job')
        const result = await fetch(submitUrl, {
            method: 'POST',
            body: JSON.stringify({runStop: runStop}),
            headers: {
                "Content-Type": "application/json"
            }
        })
        const [stopped, error] = await result.json()
        // restore stat data to previous state
        if (error) {
            let errors = ''
            for (const [errorKey, errorValues] of Object.entries(error) ) {
                for (const error of errorValues) {
                    errors += `<p>${errorKey} ${errorValues}</p>`
                }
            }
            displayErros(errors)
        }
    }

    function setEventSource(setOnStart, setOnEnd) {
        source = new EventSource('/admin/start_collect_job')
        source.addEventListener("open", (event) => {
            if (setOnStart) setOnStart() 
            console.log("The connection has been established.")
        })
        source.addEventListener("error", (error) => {
            console.log(error)
            if (setOnEnd) setOnEnd() 
            console.log("An error occurred while attempting to connect.")
            source.close()
        })
        source.addEventListener('message', (event) => {  
            const data = JSON.parse(event.data)
        })
        test = source
    }
    window.onload = () => {
        interact()
    }
    
   
</script>