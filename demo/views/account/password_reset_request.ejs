<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="stylesheet" href="/static_files/css/style.css">
  <meta charset="utf-8">
  <title>Laptico</title>
  <script src="https://kit.fontawesome.com/bd4791ad83.js" crossorigin="anonymous"></script>
</head>
<body>
<%- include('../partials/header') %>
<div class="wrapper">
    <div class="reg_log_cont">
        <div class="reg_log_header">
            <h2>Forgotten Password</h2>
            <p class="small_label">Back to <a href="/account/login">LOGIN</a></p>
        </div>
        <form class="reg_log_form" action="/account/password_reset_request" method="POST">
            <% if (errors !== {}) { %>
            <% for (const [errorType, errorList] of Object.entries(errors)) { %>
            <div class="error_cont">
                <% for (const error of errorList) { %>
                <div class="error_inner">
                <p><%= errorType %> <%= error %></p> 
                <div class="error_img">
                    <img src="/static_files/pictures/error.png"/>
                </div>
                </div>
                <% } %>
            </div>
            <% } %>
            <% } %>
            <label>Email: </label><br />
			<input class="custom_input" type="email" name="email"><br />
            <button class="register_btn" type="submit">REQUEST CHANGE PASSWORD LINK</button>
        </form>
    </div>
</div>
</body>
<footer>
  <div class="top-footer">
  </div>
</footer>
</html>