<!DOCTYPE html>
<html lang="en">
<head>
  <link rel="stylesheet" href="/static_files/css/style.css">
  <meta charset="utf-8">
  <title>Laptico</title>
  <script src="https://kit.fontawesome.com/bd4791ad83.js" crossorigin="anonymous"></script>
</head>
<body>
<%- include('../partials/header') %>
<div class="wrapper">
    <div class="reg_log_cont">
        <div class="activation_cont">
            <h2><%= header %></h2>
            <img class="main-logo" src="/static_files/pictures/danger.png" alt="token danger">
            <div class="error_cont">
              <div class="error_inner">
                <p>Failure reason: <%= error %></p> 
                <div class="error_img">
                  <img src="/static_files/pictures/error.png"/>
                </div>
              </div>
            </div>
            <p class="small_label">Go to <a href="/">Hompage</a></p>
        </div>
    </div>
</div>
</body>
<footer>
  <div class="top-footer">
  </div>
</footer>
</html>