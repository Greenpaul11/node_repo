        <div class="filter_col">
            <h3>Filters</h3>
            <form id="filter_form" method="get" action="/filter_laptops" autocomplete="off">
                <% if (!activeFilters.length === false) { %>
                    <% for (const [query, values] of activeFilters) { %>
                    <div class="active_filter_row">
                        <div>
                            <p><%= query %> : <% for (const [index, value] of values.entries()) { %>
                                <% if (values.length === 1 || index === values.length - 1) { %>
                                <b><%= value %></b>
                                <% } else { %>
                                <b><%= value %>,</b>
                                <% } %>
                            <% } %></p>
                        </div>
                        <button type="submit" value="<%= query %>">&#10005;</button>             
                    </div>
                    <% } %>
                    <div id="filter_remove_all" class="active_filter_row">
                        <div>
                            <p>Remove all</p>
                        </div>
                        <button type="submit" value="all">&#10005;</button>     
                    </div>
                <% } %>
                <div class="filter_row">
                    <p>Price</p>
                    <input type="number" name="from_price" placeholder="from" step="0.01" class="filter_input" id="id_from_price" value="<%= laptopOptions.from_price %>"> <input type="number" name="to_price" placeholder="to" step="0.01" class="filter_input" id="id_to_price" value="<%= laptopOptions.to_price %>">
                </div>
                <div class="filter_row" data-filter-category="brand">
                    <p>Brand</p>
                    <div id="id_brand">
                        <% for (const [index, option] of laptopOptions.brand.entries()) { %>
                        <% if (index === 5) { %>
                        <button type="button" class="filter_dropdown_btn" data-options-more="">Show more(<%= laptopOptions.brand.length - 5 %>)</button>
                        <% } %>
                        <% if (index < 5) { %>
                        <div data-option-show="true">
                        <% } else { %>
                        <div data-option-show="false">
                        <% } %>
                        <% if (option.disabled) { %>
                            <label for="<%= option.value %>"><input disabled type="checkbox" name="brand" value="<%= option.value %>" id="<%= option.value %>">
                            <%= option.value %><span class="checkmark"></span></label>
                        <% } else if (option.checked) { %>
                            <label for="<%= option.value %>"><input checked type="checkbox" name="brand" value="<%= option.value %>" id="<%= option.value %>">
                            <%= option.value %><span class="checkmark"></span></label>
                        <% } else { %>
                            <label for="<%= option.value %>"><input type="checkbox" name="brand" value="<%= option.value %>" id="<%= option.value %>">
