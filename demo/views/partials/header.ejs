        </li>
      </ul>
    </div>
    <div id="menu-button" class="menu-button">
      <button><img src="/static_files/svgs/menu_small.png"></button>
      <button><img src="/static_files/svgs/close.png"></button>
    </div>
    </div>
</header>
<script type="text/javascript">
  let searchButtonShow
  let headerDropdown
  let section2Wrapper
  let section2
  let menuButton
  function interactHeader() {
    headerDropdown = document.getElementById('header-dropdown')
    searchButtonShow = document.getElementById('header-button-show-search')
    searchButtonShow.addEventListener('click', (event) => {
      let active = searchButtonShow.dataset.active
      if (!active) {
        searchButtonShow.dataset.active = 'true'
        searchButtonShow.parentElement.dataset.active = 'true'
        headerDropdown.dataset.active = 'true'
      } else {
        delete searchButtonShow.dataset.active
        delete searchButtonShow.parentElement.dataset.active
        delete headerDropdown.dataset.active
      } 
    })
    section2Wrapper = document.getElementById('header-sec2')
    section2 = document.getElementById('header-list-sec2')
    const mediaQueryHeader = window.matchMedia('(max-width: 900px)')
    mediaQueryHeader.addEventListener('change',handleMobileChangeHeader)
    if (window.innerWidth <= 900) header2ToMobile()

    menuButton = document.getElementById('menu-button')
    menuButton.addEventListener('click', (event) => {
      const active = menuButton.dataset.active
      if (!active) {
        menuButton.dataset.active = 'true'
        section2.dataset.active = 'true'
      } else {
        delete menuButton.dataset.active
        delete section2.dataset.active
      }
    })

  }
  function handleMobileChangeHeader(event) {
    if (event.matches) {
      header2ToMobile()
    } else {
      header2ToDesktop()
    }
  }
  function header2ToMobile() {
    section2Wrapper.classList.add('dropdown-container')
    section2.classList.add('dropdown')
  }
  function header2ToDesktop() {
    section2Wrapper.classList.remove('dropdown-container')
    section2.classList.remove('dropdown')
  }
  interactHeader()
</script>